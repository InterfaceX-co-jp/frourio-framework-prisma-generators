generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

generator model {
  provider           = "node ./lib/generators/model/generator.js"
  output             = "./__generated__/model"
  additionalTypePath = "./additionalType.config"
  spec               = "./dto.config.ts"
}

generator repository {
  provider  = "node ./lib/generators/repository/generator.js"
  output    = "./__generated__/repository"
  modelPath = "./__generated__/model"
  spec      = "./dto.config.ts"
}

/// @dto.profile(name: Public, pick: [id, email, name])
/// @dto.profile(name: Admin, omit: [password])
model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String?
  password String /// @dto(hidden: true)

  posts Post[] /// @dto(nested: true)
  books Book[]

  initiatorUserNotification UserNotification[] @relation(name: "initiatorUser")
  receivingUserNotification UserNotification[] @relation(name: "receivingUser")
}

model UserNotification {
  id Int @id @default(autoincrement())

  receivingUserId Int?
  receivingUser   User? @relation(name: "receivingUser", fields: [receivingUserId], references: [id])

  initiatorUserId Int?
  initiatorUser   User? @relation(name: "initiatorUser", fields: [initiatorUserId], references: [id])
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Post {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  title     String
  content   String?
  published Boolean    @default(false)
  status    PostStatus @default(DRAFT)
  viewCount Int        @default(0)
  author    User?      @relation(fields: [authorId], references: [id])
  authorId  Int?
  likes     BigInt
  bytes     Bytes

  Polymorphic Polymorphic[]
  Book_Post   Book_Post[]
}

model Book {
  id       Int    @unique
  title    String
  author   User?  @relation(fields: [authorId], references: [id])
  authorId Int?

  Polymorphic Polymorphic[]
  Book_Post   Book_Post[]
}

model Map {
  key   String @id
  value String
}

enum PolymorphicRelationType {
  A
  B
}

model Polymorphic {
  id Int @id @default(autoincrement())

  value String
  type  PolymorphicRelationType

  polymorphicId Int

  PolymorphicBook Book? @relation(fields: [polymorphicId], references: [id], map: "book_polymorphicId")
  PolymorphicPost Post? @relation(fields: [polymorphicId], references: [id], map: "post_polymorphicId")
}

enum ArrayFieldExampleEnum {
  A
  B
}

model ArrayField {
  id Int @id @default(autoincrement())

  intArray      Int[]
  floatArray    Float[]
  stringArray   String[]
  booleanArray  Boolean[]
  dateTimeArray DateTime[]
  bytesArray    Bytes[]
  enumArray     ArrayFieldExampleEnum[]
}

model JsonField {
  id Int @id @default(autoincrement())

  rawJson    Json
  jsonObject Json /// @json(type: [JsonObject])
  jsonArray  Json /// @json(type: [JsonArray])
}

model JsonFieldOnly {
  id Int @id @default(autoincrement())

  data Json
}

model JsonFieldWithAdditionalType {
  id Int @id @default(autoincrement())

  data Json /// @json(type: [JsonObject])
}

model Book_Post {
  id Int @id @default(autoincrement())

  bookId Int
  Book   Book @relation(fields: [bookId], references: [id])

  postId Int
  Post   Post @relation(fields: [postId], references: [id])

  @@unique([bookId, postId])
}

model OptionalDateTime {
  id Int @id @default(autoincrement())

  optionalDateTime DateTime?
}

model SameFieldName {
  id Int @id @default(autoincrement())
}

model DecimalField {
  id              Int      @id @default(autoincrement())
  requiredDecimal Decimal  @db.Decimal(12, 0)
  optionalDecimal Decimal? @db.Decimal(12, 0)
}

/// Bug 1 regression: Json field with non-@json documentation must not produce broken output
model BugModel {
  id      Int  @id @default(autoincrement())
  payload Json /// some comment
}

/// Bug 2 regression: spec.jsonType (without @json annotation) should resolve the type
model BankAccount {
  id       Int  @id @default(autoincrement())
  bankInfo Json
}

/// Bug 2 regression: spec.jsonType takes precedence over @json annotation
model Order {
  id       Int  @id @default(autoincrement())
  metadata Json /// @json(type: [AnnotationType])
}

/// Bug 2 regression: spec.jsonType lookup works for snake_case Prisma field names
model Company {
  id        Int  @id @default(autoincrement())
  bank_info Json
}
